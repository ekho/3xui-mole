# Public values and absolute secret-file paths only. Copy outside Git and replace the examples.
# Set SOURCE_REVISION to git rev-parse HEAD in the private env file before building.
PRODUCT_NAME=3xui-mole
CABINET_HOST=cabinet.example.com
CABINET_ORIGIN=https://cabinet.example.com
TERMS_VERSION=1
PRIVACY_VERSION=1
TERMS_URL=https://policies.example.com/terms
PRIVACY_URL=https://policies.example.com/privacy
SUPPORT_URL=mailto:support@example.com
BOT_OPERATOR_IDS=
SMTP_ADDRESS=smtp.example.com:465
SMTP_USER=cabinet
SMTP_FROM=cabinet@example.com
PANEL_ID=default
PANEL_URL=https://panel.example.com
SUBSCRIPTION_BASE_URL=https://subscriptions.example.com/sub/
ACCESS_RESET_TIMEZONE=UTC
TRIAL_ENABLED=false
PANEL_DUPLICATE_GUARD_VERIFIED=false
TRIAL_PERIOD=3
TRIAL_TRAFFIC_GB=15
BONUS_DEVICES_COUNT=1
SHOP_REFERRER_REWARD_ENABLED=true
SHOP_REFERRED_REWARD_TYPE=days
SHOP_REFERRER_LEVEL_ONE_PERIOD=10
SHOP_REFERRER_LEVEL_TWO_PERIOD=3
AUDIT_RETENTION_DAYS=365
AUDIT_RETENTION_TIMEZONE=UTC
BOT_TIMEZONE=UTC
# Optional channels are disabled until credentials are configured.
TELEGRAM_ENABLED=false
SUPPORT_TELEGRAM_ENABLED=false
AUDIT_MIRROR_ENABLED=false
SHOP_PAYMENT_STARS_ENABLED=false
# Set these paths only when their channel is enabled.
BOT_TOKEN_FILE=
SUPPORT_BOT_TOKEN_FILE=
SUPPORT_GROUP_ID=
OPERATIONS_EMAIL_FILE=
# Payment overlays and the complete configuration reference: docs/engineering.md.
APP_RUNTIME_UID=10001
APP_RUNTIME_GID=10001
APP_NETWORK_SUBNET=172.31.98.0/28
APP_GATEWAY_IP=172.31.98.14
PG_USER=cabinet
BASE_DATABASE=cabinet
PG_PASSWORD_FILE=/secure/mole/pg-password
DATABASE_URL_FILE=/secure/mole/database-url
REDIS_URL_FILE=/secure/mole/redis-url
MAIL_KEY_FILE=/secure/mole/mail-key
CODE_KEY_FILE=/secure/mole/code-key
SMTP_PASSWORD_FILE=/secure/mole/smtp-password
SMTP_CA_FILE=
PANEL_TOKEN_FILE=/secure/mole/panel-token
# To use username/password instead, leave PANEL_TOKEN_FILE empty.
PANEL_USERNAME=
PANEL_PASSWORD_FILE=
PANEL_CA_FILE=
PUBLIC_CERT_FILE=/secure/mole/cabinet-cert.pem
PUBLIC_KEY_FILE=/secure/mole/cabinet-key.pem
