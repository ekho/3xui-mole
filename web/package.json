{
  "name": "3xui-mole-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "api:generate": "openapi-typescript ../docs/api/openapi.yaml -o src/api/schema.gen.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "test:e2e": "node scripts/e2e.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "dev": "vite --host 127.0.0.1",
    "lint": "eslint src --max-warnings 0",
    "format": "prettier --write src scripts tests *.ts *.js *.json",
    "test:dev": "node scripts/check-dev.mjs",
    "check:bundle": "node scripts/check-bundle.mjs"
  },
  "dependencies": {
    "@emotion/cache": "11.14.0",
    "@emotion/react": "11.14.0",
    "ra-i18n-polyglot": "5.15.4",
    "ra-language-english": "5.15.4",
    "@tanstack/react-query": "5.104.2",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-admin": "5.15.4",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "@mui/material": "9.4.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.4"
  }
}
